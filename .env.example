# TripPilot Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================================================
# LLM Configuration
# ==============================================================================

# Choose your LLM provider: openai, anthropic, or litellm
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (if using anthropic provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Configuration
DEFAULT_MODEL=gpt-4o
FAST_MODEL=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=4096

# ==============================================================================
# Application Configuration
# ==============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode
DEBUG=false

# Logging
LOG_LEVEL=INFO

# ==============================================================================
# Vector Database Configuration
# ==============================================================================

# Vector DB: chromadb or lancedb
VECTOR_DB=chromadb
CHROMADB_PATH=./data/chromadb
LANCEDB_PATH=./data/lancedb
EMBEDDING_MODEL=all-MiniLM-L6-v2
COLLECTION_NAME=travel_knowledge

# ==============================================================================
# API Configuration
# ==============================================================================

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]

# ==============================================================================
# Agent Configuration
# ==============================================================================

MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT=120
MAX_SEARCH_RESULTS=10
SEARCH_TIMEOUT=30

# ==============================================================================
# Observability
# ==============================================================================

# Enable tracing
ENABLE_TRACING=true

# Weights & Biases (optional)
WANDB_ENABLED=false
WANDB_PROJECT=trippilot
# WANDB_API_KEY=your-wandb-api-key

# ==============================================================================
# Data Sources
# ==============================================================================

TRIPADVISOR_DATASET=argilla/tripadvisor-hotel-reviews
PROCESSED_DATA_PATH=./data/processed
